{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cedar",
  "version": "0.1.0",
  "identifier": "dev.oshtz.cedar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cedar",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
